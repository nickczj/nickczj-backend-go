# Option 1: Direct secrets (simple)
DB_PASSWORD=your-db-password

# Option 2: HashiCorp Vault (comment out above, set these instead)
# VAULT_ADDR=http://vault.local:8200
# VAULT_TOKEN=your-vault-token
#
# Vault secrets should be stored at: secret/nickczj-api/
# Required keys: db_password
# Example: vault kv put secret/nickczj-api db_password=xxx
